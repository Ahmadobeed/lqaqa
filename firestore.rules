rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ahmadobeed2007@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // users/{uid}: نفس الـ UID تبع Auth
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName','lastName','username','usernameLower','email','photoURL','createdAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','photoURL']);
      allow delete: if isAdmin();
    }

    // فحص اسم المستخدم: get مسموح، list ممنوع (ما حدا بيقدر يسحب القائمة)
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // بيانات الموقع العامة (المحتوى) - قراءة للكل، كتابة للمسجلين فقط
    match /kv/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
